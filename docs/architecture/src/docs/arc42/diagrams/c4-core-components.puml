@startuml
!include <C4/C4_Component>
AddElementTag("AS-IS", $bgColor="#2E7D32", $fontColor="#FFFFFF", $legendText="AS-IS")
AddElementTag("PARTIAL", $bgColor="#B26A00", $fontColor="#FFFFFF", $legendText="PARTIAL")
AddElementTag("TARGET", $bgColor="#2457A7", $fontColor="#FFFFFF", $legendText="TARGET")
AddElementTag("DEFERRED", $bgColor="#6A5A78", $fontColor="#FFFFFF", $legendText="DEFERRED")
LAYOUT_WITH_LEGEND()
title C4 Level 3 — Governance Core Components
Container_Boundary(core, "Governance Core — Go") {
  Component(workflow, "Workflow Engine", "Domain/Application", "Durable versioned Core V0 orchestration; M1.3/M1.4 maturity remains future.", $tags="PARTIAL")
  Component(change, "Change Domain", "Domain", "Current Change aggregate; durable artifacts and M1.3 authority are target.", $tags="PARTIAL")
  Component(spec, "Specification Engine", "Application", "M1.3 target Specification Packs and validation.", $tags="TARGET")
  Component(plan, "Change Planning", "Application", "M1.3 target approved ChangePlan authority.", $tags="TARGET")
  Component(policy, "Policy Engine", "Domain/Application", "M1.0 local Manifest V1 governance.", $tags="AS-IS")
  Component(repo, "Repository Intelligence", "Application", "Current repository snapshot subset; mature model is M1.2.", $tags="PARTIAL")
  Component(impact, "Impact Engine", "Application", "Current explicit paths; mature blast radius/risk is M1.2.", $tags="PARTIAL")
  Component(router, "Agent Router", "Application", "M3.0 target capability/trust routing.", $tags="TARGET")
  Component(verify, "Verification Engine", "Application", "Current bounded checks; M1.5 broadens quality/security.", $tags="PARTIAL")
  Component(review, "Review Engine", "Application", "M1.4 target independent maker-checker review.", $tags="TARGET")
  Component(knowledge, "Specification/Change Traceability Views", "Application", "M1.3 supporting source-linked read models; never authority.", $tags="TARGET")
  Component(governanceUx, "Governance Inspection and Actions", "Inbound/Application", "M1.4 supporting presentation; never authority.", $tags="TARGET")
  Component(hardening, "Recovery and Bounded Execution", "Application/Adapters", "M1.1 durable recovery implemented; M1.5 quality-tool boundaries remain future.", $tags="PARTIAL")
  Component(memory, "Memory Engine", "Domain/Application", "M2 target typed knowledge, retrieval, promotion, invalidation.", $tags="TARGET")
  Component(audit, "Audit Ledger Service", "Domain/Application", "Durable per-Project append authority; later audit maturity remains future.", $tags="PARTIAL")
  Component(approval, "Approval Gate", "Application", "Current local disposition; mature authority is M1.4.", $tags="PARTIAL")
  Component(integration, "Canonical Integration Gate", "Application", "M0.8 exact working-tree apply/reject closure.", $tags="AS-IS")
  Component(registry, "Project Registry", "Application", "Current source association; memory association is M2.0.", $tags="PARTIAL")
}
Rel(workflow, change, "governs")
Rel(workflow, spec, "requires")
Rel(workflow, plan, "requires")
Rel(workflow, policy, "queries gates")
Rel(workflow, repo, "requests context")
Rel(repo, impact, "provides repository model")
Rel(workflow, router, "requests role execution")
Rel(workflow, verify, "requests verification")
Rel(workflow, review, "requests review")
Rel(workflow, knowledge, "projects governed context")
Rel(governanceUx, workflow, "invokes governed actions")
Rel(workflow, hardening, "executes within bounds")
Rel(workflow, memory, "requests context/promotion")
Rel(workflow, audit, "emits events")
Rel(workflow, approval, "requests authority")
Rel(workflow, integration, "requests exact accepted application")
Rel(workflow, registry, "resolves project")
Rel(impact, policy, "provides surface evidence")
Rel(verify, policy, "provides deterministic evidence")
Rel(memory, audit, "emits memory events")
@enduml
