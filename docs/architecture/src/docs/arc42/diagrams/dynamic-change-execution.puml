@startuml
!include <C4/C4_Dynamic>
AddElementTag("AS-IS", $bgColor="#2E7D32", $fontColor="#FFFFFF", $legendText="AS-IS")
AddElementTag("PARTIAL", $bgColor="#B26A00", $fontColor="#FFFFFF", $legendText="PARTIAL")
AddElementTag("TARGET", $bgColor="#2457A7", $fontColor="#FFFFFF", $legendText="TARGET")
LAYOUT_WITH_LEGEND()
title Dynamic View — Governed Implementation [COMPOSITE TARGET]
Person(engineer, "Engineer", $tags="AS-IS")
Container(cli, "CLI", "Go", $tags="AS-IS")
Container(core, "Workflow/Governance Core", "Go", $tags="PARTIAL")
ContainerDb(changeStore, "Per-Project Change Authority", "SQLite", $tags="TARGET")
Container(sandbox, "Isolated Proposal Worktree", "Git worktree", $tags="AS-IS")
System_Ext(ai, "Implementer AI Provider", "Explicitly selected adapter", $tags="AS-IS")
System_Ext(tools, "Verification Tools", "Current bounded tests; broader tools target", $tags="PARTIAL")
System_Ext(src, "Source Repository", "Git", $tags="AS-IS")
RelIndex(1, engineer, cli, "implement approved Change")
RelIndex(2, cli, core, "request transition")
RelIndex(3, core, changeStore, "commit reservation / exact authority revisions")
RelIndex(4, core, sandbox, "create constrained execution")
RelIndex(5, core, ai, "send spec + plan + context + allowed surface")
RelIndex(6, ai, sandbox, "propose edits via allowed tools")
RelIndex(7, sandbox, core, "return patch/diff")
RelIndex(8, core, tools, "run deterministic verification")
RelIndex(9, core, core, "policy + change-surface + independent review")
RelIndex(10, core, cli, "show evidence / require approval")
RelIndex(11, engineer, cli, "accept")
RelIndex(12, core, src, "apply exact PRE; verify POST under short lock")
RelIndex(13, core, changeStore, "commit completion while exclusion remains")
@enduml
