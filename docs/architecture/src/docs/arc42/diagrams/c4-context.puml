@startuml
!include <C4/C4_Context>
AddElementTag("AS-IS", $bgColor="#2E7D32", $fontColor="#FFFFFF", $legendText="AS-IS")
AddElementTag("PARTIAL", $bgColor="#B26A00", $fontColor="#FFFFFF", $legendText="PARTIAL")
AddElementTag("TARGET", $bgColor="#2457A7", $fontColor="#FFFFFF", $legendText="TARGET")
AddElementTag("DEFERRED", $bgColor="#6A5A78", $fontColor="#FFFFFF", $legendText="DEFERRED")
LAYOUT_WITH_LEGEND()
title C4 Level 1 — System Context
Person(engineer, "Software Engineer", "Initiates changes, reviews evidence, approves/rejects decisions.", $tags="AS-IS")
Person(architect, "Architect / Security / Reviewer", "Provides higher-authority approvals and exceptions where policy requires.", $tags="TARGET")
System(runtime, "Governed AI Software Engineering Runtime", "Orchestrates controlled software changes, verification, AI roles, memory and audit.", $tags="PARTIAL")
System_Ext(ai, "AI Providers", "Replaceable external/local model runtimes; codex-cli is the current adapter.", $tags="PARTIAL")
System_Ext(source, "Source Git / SCM", "Local Git is current; hosted SCM integration is future.", $tags="PARTIAL")
System_Ext(memory, "Memory Git Repository", "Target durable project/organization engineering memory, separate from source.", $tags="TARGET")
System_Ext(issue, "Issue Tracker", "Target source of normalized Change intent and requirements.", $tags="TARGET")
System_Ext(tools, "Engineering Tools", "Current bounded test execution; broader analyzers/scanners are target.", $tags="PARTIAL")
Rel(engineer, runtime, "Operates through CLI / future interfaces")
Rel(architect, runtime, "Reviews/approves governed transitions")
Rel(runtime, ai, "Invokes allowed role/model", "Provider adapters")
Rel(runtime, source, "Reads source; proposes/applies accepted changes", "Git/SCM adapters")
Rel(runtime, memory, "Reads/writes governed memory records", "Git/Memory adapters")
Rel(runtime, issue, "Reads change intent", "Issue adapter")
Rel(runtime, tools, "Executes deterministic verification", "Tool adapters")
@enduml
